{% if app_count > 0 %}
<div class="layout layout--col gap--base">
  <div class="grid grid--cols-3 w--full">
    <div class="item">
      <div class="content">
        <span class="value value--xlarge lg:value--mega lg:portrait:value--xxxlarge value--tnums">{% render "capped_count", count: open_exception_count %}</span>
        <span class="label lg:label--xlarge">Open errors</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="value value--xlarge lg:value--mega lg:portrait:value--xxxlarge value--tnums">{% render "capped_count", count: open_performance_count %}</span>
        <span class="label lg:label--xlarge">Slow actions</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="value value--xlarge lg:value--mega lg:portrait:value--xxxlarge value--tnums">{{ monitors_down }}<span class="text--gray-50 1bit:text--black">/{{ monitor_count }}</span></span>
        <span class="label lg:label--xlarge">Monitors down</span>
      </div>
    </div>
  </div>

  <div class="columns w--full">
    <div class="column" data-overflow="true" data-overflow-counter="true">
      <span class="label label--underline lg:label--xlarge">Latest errors</span>
      {% for entry in exceptions limit: 8 %}
        {% render "exception_item", incident: entry.incident, label: entry.label, now: now_seconds, detailed: true %}
      {% else %}
        <span class="description lg:description--xlarge">No open errors.</span>
      {% endfor %}
    </div>
    <div class="column portrait:hidden" data-overflow="true" data-overflow-counter="true">
      <span class="label label--underline lg:label--xlarge">Latest performance issues</span>
      {% for entry in performances limit: 8 %}
        {% render "performance_item", incident: entry.incident, label: entry.label, now: now_seconds %}
      {% else %}
        <span class="description lg:description--xlarge">No open performance issues.</span>
      {% endfor %}
    </div>
    {% comment %}
      Only monitors that are down are listed; the count above covers the rest.
      Only the TRMNL X in landscape is wide enough for a third column.
    {% endcomment %}
    <div class="column hidden lg:flex lg:portrait:hidden" data-overflow="true" data-overflow-counter="true">
      <span class="label label--underline lg:label--xlarge">Failing monitors</span>
      {% for entry in monitors_down_list %}
        {% if entry.kind == "uptime" %}{% render "uptime_item", monitor: entry.monitor, label: entry.label %}{% else %}{% render "check_in_item", check_in: entry.monitor, label: entry.label, now: now_seconds %}{% endif %}
      {% endfor %}
      {% if monitor_count == 0 %}
        <span class="description lg:description--xlarge">No monitors.</span>
      {% elsif monitors_down == 0 %}
        <span class="description lg:description--xlarge">All {{ monitor_count }} monitors up.</span>
      {% endif %}
    </div>
  </div>
</div>
{% else %}
  {% render "problem", errors: errors, message: problem_message %}
{% endif %}

{% render "title_bar", title: screen_title %}
