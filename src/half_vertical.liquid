{% if app_count > 0 %}
{% comment %}
  On the TRMNL X, each count fits three characters at the largest sizes
  below. A longer monitor count (4/10, 12/16) steps every count down a size.
{% endcomment %}
{% if monitor_text_length > 4 %}
  {% assign count_size = "lg:landscape:value--xlarge lg:portrait:value--large" %}
{% elsif monitor_text_length > 3 %}
  {% assign count_size = "lg:landscape:value--xxlarge lg:portrait:value--xlarge" %}
{% else %}
  {% assign count_size = "lg:landscape:value--xxxlarge lg:portrait:value--xxlarge" %}
{% endif %}
<div class="layout layout--col gap--base">
  <div class="grid grid--cols-2 w--full">
    <div class="item">
      <div class="content">
        <span class="value value--large {{ count_size }} value--tnums">{% render "capped_count", count: open_exception_count %}</span>
        <span class="label lg:label--xlarge">Errors</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="value value--large {{ count_size }} value--tnums">{{ monitors_down }}<span class="text--gray-50 1bit:text--black">/{{ monitor_count }}</span></span>
        <span class="label lg:label--xlarge">Down</span>
      </div>
    </div>
  </div>
  <div class="columns w--full" data-overflow-max-cols="1">
    <div class="column" data-overflow="true" data-overflow-counter="true">
      {% for entry in exceptions limit: 8 %}
        {% render "exception_item", incident: entry.incident, label: entry.label, now: now_seconds, detailed: false %}
      {% else %}
        <span class="description lg:description--xlarge">No open errors.</span>
      {% endfor %}
    </div>
  </div>
</div>
{% else %}
  {% render "problem", errors: errors, message: problem_message %}
{% endif %}

{% render "title_bar", title: screen_title %}
