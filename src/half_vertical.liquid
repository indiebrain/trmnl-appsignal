{% if app %}
<div class="layout layout--col gap--base">
  <div class="grid grid--cols-2 w--full">
    <div class="item">
      <div class="content">
        <span class="value value--large lg:value--xxxlarge lg:portrait:value--xxlarge value--tnums">{% render "capped_count", count: open_exception_count %}</span>
        <span class="label lg:label--xlarge">Errors</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="value value--large lg:value--xxxlarge lg:portrait:value--xxlarge value--tnums">{{ monitors_down }}<span class="text--gray-50 1bit:text--black">/{{ monitor_count }}</span></span>
        <span class="label lg:label--xlarge">Down</span>
      </div>
    </div>
  </div>
  <div class="column w--full" data-overflow="true" data-overflow-counter="true">
    {% for incident in app.exceptionIncidents %}
      {% render "exception_item", incident: incident, now: now_seconds, detailed: false %}
    {% else %}
      <span class="description lg:description--xlarge">No open errors.</span>
    {% endfor %}
  </div>
</div>
{% else %}
  {% render "problem", errors: errors %}
{% endif %}

{% render "title_bar", app: app %}
