{% comment %}
  Shared by every layout. The polled GraphQL response arrives as `data`
  (or `errors` when AppSignal rejects the request). This part picks the apps to
  show and merges their incidents and monitors, so the layouts draw one app or
  every app the same way.
{% endcomment %}
{% assign now_seconds = "now" | date: "%s" | plus: 0 %}
{% assign organization = trmnl.plugin_settings.custom_fields_values.organization | default: "" | strip | downcase %}
{% assign wanted_app = trmnl.plugin_settings.custom_fields_values.app | default: "" | strip | downcase %}

{% if organization == "demo" %}
  {% comment %}
    Example data for the marketplace picture and for trying the plugin out.
    Times are offsets from now, so the screen always looks recent.
  {% endcomment %}
  {% capture demo_json %}
  {"apps": [{
    "name": "example-app", "environment": "production",
    "openExceptions": [{"number": 412}, {"number": 409}, {"number": 398}, {"number": 377}, {"number": 351}, {"number": 344}, {"number": 310}],
    "openPerformance": [{"number": 405}, {"number": 388}, {"number": 362}],
    "exceptionIncidents": [
      {"number": 412, "count": 1843, "lastOccurredAt": "{{ now_seconds | minus: 240 }}", "exceptionName": "ActiveRecord::RecordNotFound", "exceptionMessage": "Couldn't find Shift with 'id'=88123", "namespace": "web", "actionNames": ["ShiftsController#show"]},
      {"number": 409, "count": 312, "lastOccurredAt": "{{ now_seconds | minus: 2340 }}", "exceptionName": "Net::ReadTimeout", "exceptionMessage": "Net::ReadTimeout with #<TCPSocket:(closed)>", "namespace": "background", "actionNames": ["SyncCalendarJob#perform"]},
      {"number": 398, "count": 57, "lastOccurredAt": "{{ now_seconds | minus: 14280 }}", "exceptionName": "NoMethodError", "exceptionMessage": "private method 'email' called for nil", "namespace": "web", "actionNames": ["RostersController#export"]},
      {"number": 377, "count": 21, "lastOccurredAt": "{{ now_seconds | minus: 69600 }}", "exceptionName": "Redis::CannotConnectError", "exceptionMessage": "Error connecting to Redis on 10.0.0.12:6379 (Errno::ECONNREFUSED)", "namespace": "background", "actionNames": ["ReminderMailerJob#perform"]},
      {"number": 351, "count": 9, "lastOccurredAt": "{{ now_seconds | minus: 197100 }}", "exceptionName": "ActionController::InvalidAuthenticityToken", "exceptionMessage": "Can't verify CSRF token authenticity.", "namespace": "web", "actionNames": ["SessionsController#create"]},
      {"number": 344, "count": 4, "lastOccurredAt": "{{ now_seconds | minus: 325620 }}", "exceptionName": "JSON::ParserError", "exceptionMessage": "unexpected token at '<html>'", "namespace": "background", "actionNames": ["ImportHolidaysJob#perform"]},
      {"number": 310, "count": 2, "lastOccurredAt": "{{ now_seconds | minus: 982800 }}", "exceptionName": "ArgumentError", "exceptionMessage": "invalid date", "namespace": "web", "actionNames": ["ReportsController#index"]}
    ],
    "performanceIncidents": [
      {"number": 405, "count": 940, "lastOccurredAt": "{{ now_seconds | minus: 600 }}", "namespace": "web", "actionNames": ["RostersController#index"], "mean": 2381.4, "hasNPlusOne": true},
      {"number": 388, "count": 120, "lastOccurredAt": "{{ now_seconds | minus: 20880 }}", "namespace": "background", "actionNames": ["NightlyDigestJob#perform"], "mean": 18450.2, "hasNPlusOne": false},
      {"number": 362, "count": 33, "lastOccurredAt": "{{ now_seconds | minus: 249300 }}", "namespace": "web", "actionNames": ["Api::ShiftsController#update"], "mean": 812.9, "hasNPlusOne": false}
    ],
    "uptimeMonitors": [
      {"name": "Homepage", "alerts": [{"state": "CLOSED"}]},
      {"name": "API", "alerts": [{"state": "OPEN"}, {"state": "CLOSED"}]},
      {"name": "Status", "alerts": []}
    ],
    "checkIns": {"triggers": [
      {"identifier": "nightly-backup", "kind": "CRON", "lastState": "FINISHED", "lastUpdateAt": "{{ now_seconds | minus: 19800 }}"},
      {"identifier": "queue-worker", "kind": "HEARTBEAT", "lastState": "FINISHED", "lastUpdateAt": "{{ now_seconds | minus: 120 }}"}
    ]}
  }, {
    "name": "billing-api", "environment": "production",
    "openExceptions": [{"number": 58}, {"number": 57}],
    "openPerformance": [],
    "exceptionIncidents": [
      {"number": 58, "count": 41, "lastOccurredAt": "{{ now_seconds | minus: 720 }}", "exceptionName": "Stripe::RateLimitError", "exceptionMessage": "Request rate limit exceeded", "namespace": "web", "actionNames": ["WebhooksController#create"]},
      {"number": 57, "count": 6, "lastOccurredAt": "{{ now_seconds | minus: 180000 }}", "exceptionName": "Faraday::ConnectionFailed", "exceptionMessage": "Failed to open TCP connection to api.example.com:443", "namespace": "background", "actionNames": ["InvoiceExportJob#perform"]}
    ],
    "performanceIncidents": [],
    "uptimeMonitors": [],
    "checkIns": {"triggers": [
      {"identifier": "invoice-sync", "kind": "CRON", "lastState": "MISSED", "lastUpdateAt": "{{ now_seconds | minus: 5400 }}"}
    ]}
  }]}
  {% endcapture %}
  {% assign demo = demo_json | parse_json %}
  {% assign org_apps = demo.apps %}
{% else %}
  {% assign org_apps = data.organization.apps %}
{% endif %}

{% comment %}
  A blank App setting shows every app. Otherwise it matches an app's name, or
  its name and environment ("duty-roster staging"), ignoring case.
{% endcomment %}
{% if wanted_app == "" %}
  {% assign apps = org_apps %}
{% else %}
  {% assign sep = "" %}
  {% capture apps_json %}[{% for a in org_apps %}{% assign name = a.name | downcase %}{% assign name_env = a.name | append: " " | append: a.environment | downcase %}{% if name == wanted_app or name_env == wanted_app %}{{ sep }}{{ a | json }}{% assign sep = "," %}{% endif %}{% endfor %}]{% endcapture %}
  {% assign apps = apps_json | parse_json %}
{% endif %}
{% assign app_count = apps | size %}

{% if app_count == 0 and org_apps.size > 0 %}
  {% capture problem_message %}No app named "{{ wanted_app }}". Apps in this organization: {% for a in org_apps %}{{ a.name }} {{ a.environment }}{% unless forloop.last %}, {% endunless %}{% endfor %}.{% endcapture %}
{% endif %}

{% comment %}
  With more than one app, each row names its app, adding the environment when
  two apps share a name.
{% endcomment %}
{% assign app_names = apps | map: "name" %}
{% assign unique_app_names = app_names | uniq %}
{% if unique_app_names.size < app_names.size %}{% assign label_environment = true %}{% else %}{% assign label_environment = false %}{% endif %}

{% if app_count == 0 %}
  {% assign screen_title = "" %}
{% elsif app_count == 1 %}
  {% assign only_app = apps | first %}
  {% capture screen_title %}{{ only_app.name }} {{ only_app.environment }}{% endcapture %}
{% elsif wanted_app == "" %}
  {% capture screen_title %}All apps ({{ app_count }}){% endcapture %}
{% else %}
  {% assign first_app = apps | first %}{% capture screen_title %}{{ first_app.name }} ({{ app_count }} environments){% endcapture %}
{% endif %}

{% comment %}
  Liquid cannot merge lists by date, so each incident is written out as JSON
  with its app label and time in seconds, then parsed back and sorted.
{% endcomment %}
{% assign open_exception_count = 0 %}
{% assign open_performance_count = 0 %}
{% assign exception_sep = "" %}
{% assign performance_sep = "" %}
{% assign monitor_sep = "" %}
{% capture exceptions_json %}[{% for a in apps %}{% if app_count > 1 %}{% if label_environment %}{% assign label = a.name | append: " " | append: a.environment %}{% else %}{% assign label = a.name %}{% endif %}{% else %}{% assign label = "" %}{% endif %}{% for incident in a.exceptionIncidents %}{{ exception_sep }}{"label": {{ label | json }}, "at": {{ incident.lastOccurredAt | date: "%s" | plus: 0 }}, "incident": {{ incident | json }}}{% assign exception_sep = "," %}{% endfor %}{% endfor %}]{% endcapture %}
{% capture performances_json %}[{% for a in apps %}{% if app_count > 1 %}{% if label_environment %}{% assign label = a.name | append: " " | append: a.environment %}{% else %}{% assign label = a.name %}{% endif %}{% else %}{% assign label = "" %}{% endif %}{% for incident in a.performanceIncidents %}{{ performance_sep }}{"label": {{ label | json }}, "at": {{ incident.lastOccurredAt | date: "%s" | plus: 0 }}, "incident": {{ incident | json }}}{% assign performance_sep = "," %}{% endfor %}{% endfor %}]{% endcapture %}
{% comment %}
  A monitor is down when an uptime monitor has an OPEN alert, or a check-in
  monitor's latest run was missed or late.
{% endcomment %}
{% capture monitors_json %}[{% for a in apps %}{% if app_count > 1 %}{% if label_environment %}{% assign label = a.name | append: " " | append: a.environment %}{% else %}{% assign label = a.name %}{% endif %}{% else %}{% assign label = "" %}{% endif %}{% for monitor in a.uptimeMonitors %}{% assign open_alerts = monitor.alerts | where: "state", "OPEN" %}{{ monitor_sep }}{"label": {{ label | json }}, "kind": "uptime", "state": "{% if open_alerts.size > 0 %}down{% else %}up{% endif %}", "monitor": {{ monitor | json }}}{% assign monitor_sep = "," %}{% endfor %}{% for check_in in a.checkIns.triggers %}{{ monitor_sep }}{"label": {{ label | json }}, "kind": "check_in", "state": "{% if check_in.lastState == "MISSED" or check_in.lastState == "LATE" %}down{% else %}up{% endif %}", "monitor": {{ check_in | json }}}{% assign monitor_sep = "," %}{% endfor %}{% endfor %}]{% endcapture %}
{% for a in apps %}
  {% assign app_exception_count = a.openExceptions | size %}
  {% assign app_performance_count = a.openPerformance | size %}
  {% assign open_exception_count = open_exception_count | plus: app_exception_count %}
  {% assign open_performance_count = open_performance_count | plus: app_performance_count %}
{% endfor %}

{% assign exceptions = exceptions_json | parse_json | sort: "at" | reverse %}
{% assign performances = performances_json | parse_json | sort: "at" | reverse %}
{% assign monitors = monitors_json | parse_json %}
{% assign monitors_down_list = monitors | where: "state", "down" %}
{% assign monitors_up_list = monitors | where: "state", "up" %}
{% assign monitors_down = monitors_down_list | size %}
{% assign monitor_count = monitors | size %}

{% template capped_count %}{% if count >= 100 %}99+{% else %}{{ count }}{% endif %}{% endtemplate %}

{% template time_ago %}{% assign seconds = now | minus: at | at_least: 0 %}{% if seconds < 3600 %}{{ seconds | divided_by: 60 }}m{% elsif seconds < 86400 %}{{ seconds | divided_by: 3600 }}h{% else %}{{ seconds | divided_by: 86400 }}d{% endif %} ago{% endtemplate %}

{% comment %}
  Long Ruby names (Api::ShiftsController#update) get a zero-width space after
  :: and # so they can break there, letting a one-line clamp end them with an
  ellipsis instead of running past the edge.
{% endcomment %}
{% template exception_item %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="title title--small lg:title--large" data-clamp="1">{{ incident.exceptionName | default: "Unknown error" | escape | replace: "::", "::&#8203;" }}</span>
    {% if detailed %}<span class="description lg:description--xlarge" data-clamp="1">{{ incident.exceptionMessage | escape }}</span>{% endif %}
    <div class="flex flex--wrap gap--small">
      {% if label != blank %}<span class="label label--small lg:label--large label--outline" data-clamp="1">{{ label | escape }}</span>{% endif %}
      <span class="label label--small lg:label--large">#{{ incident.number }}</span>
      <span class="label label--small lg:label--large label--underline">{{ incident.count | number_with_delimiter }}x</span>
      <span class="label label--small lg:label--large">{% assign at = incident.lastOccurredAt | date: "%s" | plus: 0 %}{% render "time_ago", now: now, at: at %}</span>
      {% if detailed %}<span class="label label--small lg:label--large label--gray 1bit:text--black" data-clamp="1">{{ incident.actionNames | first | default: incident.namespace | escape | replace: "#", "#&#8203;" | replace: "::", "::&#8203;" }}</span>{% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template performance_item %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="title title--small lg:title--large" data-clamp="1">{{ incident.actionNames | first | default: incident.namespace | escape | replace: "#", "#&#8203;" | replace: "::", "::&#8203;" }}</span>
    <div class="flex flex--wrap gap--small">
      {% if label != blank %}<span class="label label--small lg:label--large label--outline" data-clamp="1">{{ label | escape }}</span>{% endif %}
      <span class="label label--small lg:label--large">#{{ incident.number }}</span>
      <span class="label label--small lg:label--large label--underline">{{ incident.mean | round }}ms mean</span>
      <span class="label label--small lg:label--large">{% assign at = incident.lastOccurredAt | date: "%s" | plus: 0 %}{% render "time_ago", now: now, at: at %}</span>
      {% if incident.hasNPlusOne %}<span class="label label--small lg:label--large label--inverted">N+1</span>{% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template uptime_item %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="title title--small lg:title--large" data-clamp="1">{{ monitor.name | escape }}</span>
    <div class="flex flex--wrap gap--small">
      {% if label != blank %}<span class="label label--small lg:label--large label--outline" data-clamp="1">{{ label | escape }}</span>{% endif %}
      {% if down %}<span class="label label--small lg:label--large label--inverted">Down</span>{% else %}<span class="label label--small lg:label--large">Up</span>{% endif %}
      <span class="label label--small lg:label--large label--gray 1bit:text--black">Uptime</span>
    </div>
  </div>
</div>
{% endtemplate %}

{% template check_in_item %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="title title--small lg:title--large" data-clamp="1">{{ check_in.identifier | escape }}</span>
    <div class="flex flex--wrap gap--small">
      {% if label != blank %}<span class="label label--small lg:label--large label--outline" data-clamp="1">{{ label | escape }}</span>{% endif %}
      {% case check_in.lastState %}
        {% when "FINISHED" %}<span class="label label--small lg:label--large">OK</span>
        {% when "STARTED" %}<span class="label label--small lg:label--large">Running</span>
        {% when "NEW" %}<span class="label label--small lg:label--large">Waiting</span>
        {% when "MISSED" %}<span class="label label--small lg:label--large label--inverted">Missed</span>
        {% when "LATE" %}<span class="label label--small lg:label--large label--inverted">Late</span>
        {% else %}<span class="label label--small lg:label--large">Unexpected</span>
      {% endcase %}
      <span class="label label--small lg:label--large label--gray 1bit:text--black">{% if check_in.kind == "HEARTBEAT" %}Heartbeat{% else %}Cron{% endif %}</span>
      {% if check_in.lastUpdateAt %}<span class="label label--small lg:label--large">{% assign at = check_in.lastUpdateAt | date: "%s" | plus: 0 %}{% render "time_ago", now: now, at: at %}</span>{% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template problem %}
<div class="layout layout--col layout--center gap--small">
  <span class="title">AppSignal did not answer</span>
  <span class="description text--center">
    {% if message %}{{ message | escape }}{% elsif errors %}{{ errors | map: "message" | join: "; " | escape }} Check the organization name in the plugin settings, or connect again.{% else %}No apps found. Check the organization name in the plugin settings.{% endif %}
  </span>
</div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <span class="title">AppSignal</span>
  <span class="instance">{{ title | escape }}</span>
</div>
{% endtemplate %}
